# Arithmetic
add(x, y) = x + y
add(3, 4) # => 7

# Tuple construction
pair = (1, 2)
triple = (1, 2, 3)

# Access by position
pair.0     # => 1
pair.1     # => 2
triple.2   # => 3

# Destructuring
(a, b) = pair
a  # => 1
b  # => 2

# Named fields
point = (x: 10, y: 20)
point.x    # => 10

# Factorial
factorial(0) = 1
factorial(n) = n * factorial(n - 1)

factorial(5)  # => 120

# Fibonacci with accumulation
fibAcc(0, (a, b)) = a
fibAcc(n, (a, b)) = fibAcc(n - 1, (b, a + b))

fib(n) = fibAcc(n, (0, 1))
fib(10)  # => 55

# Sum a list (nested tuples)
sumList(()) = 0
sumList((x, rest)) = x + sumList(rest)

sumList((1, (2, (3, (4, ())))))  # => 10

# Person record
person = (name: "Alice", age: 30, email: "alice@example.com")
person.name    # => "Alice"

# Destructure selectively
(name: n, age: a) = person
n  # => "Alice"
a  # => 30

# Update pattern (immutable)
older = (name: person.name, age: person.age + 1, email: person.email)
older.age  # => 31

# Function with record
greet((name: n, _)) = "Hello, " + n
greet(person)  # => "Hello, Alice"

user = (
  name: "Bob",
  address: (
    street: "123 Main St",
    city: "NYC",
    zip: "10001"
  ),
  contact: (
    email: "bob@example.com",
    phone: "555-1234"
  )
)

user.address.city        # => "NYC"
user.contact.email       # => "bob@example.com"
user.contact.phone       # => "555-1234"

# Deep destructuring
(name: n, address: (city: c, _), _) = user
n  # => "Bob"
c  # => "NYC"

# Tree: (value, left, right)
tree = (
  value: 5,
  left: (
    value: 3,
    left: (value: 2, left: (), right: ()),
    right: (value: 4, left: (), right: ())
  ),
  right: (
    value: 7,
    left: (),
    right: (value: 8, left: (), right: ())
  )
)

# Sum all values
treeSum(()) = 0
treeSum((value: v, left: l, right: r)) = v + treeSum(l) + treeSum(r)
treeSum(tree)  # => 29

# Find maximum
# treeMax(()) = -999999
# treeMax((value: v, left: l, right: r)) =
#  max(v, max(treeMax(l), treeMax(r)))
# treeMax(tree)  # => 8

# Inorder traversal (list output)
# inorder(()) = ()
# inorder((value: v, left: l, right: r)) =
#  append(inorder(l), (v, inorder(r)))

# List: (head, tail)
list = (1, (2, (3, (4, ()))))

# Length
len(()) = 0
len((_, tail)) = 1 + len(tail)
len(list)  # => 4

# Reverse with accumulator
revAcc((), acc) = acc
revAcc((h, t), acc) = revAcc(t, (h, acc))

reverse(lst) = revAcc(lst, ())
reverse(list)  # => (4, (3, (2, (1, ()))))

# Map
mapList(_, ()) = ()
mapList(f, (h, t)) = (f(h), mapList(f, t))

double = mapList(\x -> x * 2, list)
double # => (2, (4, (6, (8, ()))))

# Filter
filterList(_, ()) = ()
filterList(pred, (h, t)) =
  if pred(h) then
    (h, filterList(pred, t))
  else
    filterList(pred, t)